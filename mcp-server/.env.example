# MCP Server Environment Variables
PORT=3100

# Spring Boot backend URL (internal Docker network name)
BACKEND_URL=http://backend:8080

# Shared secret token — must match MCP_SERVICE_TOKEN in the backend .env
MCP_SERVICE_TOKEN=change-me-long-random-token
# OpenAI-compatible LLM config (used only if the MCP server also acts as an LLM proxy)
# These match the backend chatbot AI settings
CHATBOT_AI_BASE_URL=https://openrouter.ai/api/v1
CHATBOT_AI_API_KEY=your-openrouter-or-openai-api-key
CHATBOT_AI_MODEL=google/gemma-3-4b-it:free

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Log level
LOG_LEVEL=info
