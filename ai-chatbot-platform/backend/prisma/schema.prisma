generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String?
  oauthProvider   String?
  oauthSubject    String?
  name            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  conversations   Conversation[]
  memories        Memory[]
  documents       Document[]
}

model Conversation {
  id          String     @id @default(uuid())
  userId      String
  title       String
  summary     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id])
  messages    Message[]
}

model Message {
  id              String    @id @default(uuid())
  conversationId  String
  role            String
  content         String
  toolCallsJson   Json?
  tokenCount      Int?
  createdAt       DateTime  @default(now())
  conversation    Conversation @relation(fields: [conversationId], references: [id])
}

model Memory {
  id            String   @id @default(uuid())
  userId         String
  conversationId String?
  text           String
  embedding      Unsupported("vector(1536)")
  score          Float?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

model Document {
  id         String   @id @default(uuid())
  userId      String
  filename    String
  mimeType    String
  rawText     String
  createdAt   DateTime @default(now())
  chunks      DocumentChunk[]
  user        User     @relation(fields: [userId], references: [id])
}

model DocumentChunk {
  id          String   @id @default(uuid())
  documentId  String
  content     String
  embedding   Unsupported("vector(1536)")
  metadata    Json
  createdAt   DateTime @default(now())
  document    Document @relation(fields: [documentId], references: [id])
}

model McpServer {
  id          String   @id @default(uuid())
  name        String   @unique
  transport   String
  endpoint    String?
  command     String?
  argsJson    Json?
  enabled     Boolean  @default(true)
  trusted     Boolean  @default(false)
  tlsRequired Boolean  @default(true)
  fingerprint String?
  createdAt   DateTime @default(now())
}

model ToolLog {
  id            String   @id @default(uuid())
  conversationId String?
  toolName      String
  serverName    String?
  argsJson      Json
  outputJson    Json?
  status        String
  errorMessage  String?
  latencyMs     Int?
  retries       Int?
  traceId       String?
  correlationId String?
  userId        String?
  role          String?
  createdAt     DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([toolName, createdAt])
  @@index([status, createdAt])
  @@index([traceId])
}

model AiAuditEvent {
  id            String   @id @default(uuid())
  traceId       String
  correlationId String
  conversationId String?
  userId        String?
  role          String?
  eventType     String
  serverName    String?
  toolName      String?
  status        String
  durationMs    Int?
  retries       Int?
  tokenUsage    Int?
  inputJson     Json?
  outputJson    Json?
  errorMessage  String?
  metadataJson  Json?
  createdAt     DateTime @default(now())

  @@index([traceId])
  @@index([conversationId, createdAt])
  @@index([eventType, createdAt])
  @@index([status, createdAt])
}

model AiSecurityEvent {
  id            String   @id @default(uuid())
  traceId       String
  correlationId String
  conversationId String?
  userId        String?
  eventType     String
  severity      String
  payloadJson   Json?
  createdAt     DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([severity, createdAt])
}
