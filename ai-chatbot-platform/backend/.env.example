NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aichat
REDIS_URL=redis://redis:6379
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JWT_SECRET=replace-me
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/oauth/github/callback
MCP_FILESYSTEM_CMD=npx
MCP_FILESYSTEM_ARGS=-y,@modelcontextprotocol/server-filesystem,.
MCP_GITHUB_CMD=npx
MCP_GITHUB_ARGS=-y,@modelcontextprotocol/server-github
MCP_BROWSER_WS_URL=ws://browser-mcp:8080
