@startuml
title AD01 - Quản lý tài khoản cá nhân
|Actor|
start
:Người dùng chọn chức năng quản lý tài khoản;
|System|
:Hệ thống hiển thị thông tin tài khoản hiện tại;
repeat
  |Actor|
  :Người dùng chỉnh sửa thông tin (tên, số điện thoại, địa chỉ);
  :Người dùng nhấn lưu thay đổi;
  |System|
  :Hệ thống kiểm tra tính hợp lệ của thông tin;
  if (Thông tin hợp lệ?) then (Yes)
    :Hệ thống cập nhật thông tin tài khoản;
    :Hệ thống thông báo cập nhật thành công;
    break
  else (No)
    :Hệ thống thông báo lỗi định dạng;
    :Yêu cầu người dùng nhập lại;
  endif
repeat while (Nhập lại) is (Yes)
stop
@enduml

@startuml
title AD02 - Đăng ký tài khoản
|Actor|
start
:Người dùng chọn đăng ký;
repeat
  |Actor|
  :Người dùng nhập thông tin đăng ký (email, mật khẩu, tên);
  :Người dùng nhấn nút đăng ký;
  |System|
  :Hệ thống kiểm tra thông tin;
  if (Thông tin hợp lệ và email chưa tồn tại?) then (Yes)
    :Hệ thống tạo tài khoản mới ở trạng thái chờ xác thực;
    :Hệ thống gửi email chứa mã/link xác thực;
    :Hệ thống thông báo đăng ký thành công và yêu cầu kiểm tra email;
    break
  else (No)
    :Hệ thống thông báo lỗi (email đã tồn tại hoặc thông tin không hợp lệ);
    :Yêu cầu người dùng kiểm tra lại thông tin;
  endif
repeat while (Nhập lại) is (Yes)
stop
@enduml

@startuml
title AD03 - Xác thực email
|Actor|
start
repeat
  |Actor|
  :Người dùng mở email và click vào link xác thực hoặc nhập mã;
  |System|
  :Hệ thống kiểm tra mã/link xác thực;
  if (Mã/link hợp lệ và chưa hết hạn?) then (Yes)
    :Hệ thống cập nhật trạng thái tài khoản thành đã xác thực;
    :Hệ thống thông báo xác thực thành công;
    break
  else (No)
    :Hệ thống thông báo link/mã không hợp lệ hoặc đã hết hạn;
    :Gợi ý người dùng gửi lại email xác thực;
  endif
repeat while (Thử lại) is (Yes)
stop
@enduml

@startuml
title AD04 - Gửi lại email xác thực
|Actor|
start
:Người dùng yêu cầu gửi lại email xác thực;
repeat
  |Actor|
  :Người dùng nhập địa chỉ email;
  |System|
  :Hệ thống kiểm tra email;
  if (Email tồn tại và chưa được xác thực?) then (Yes)
    :Hệ thống tạo mã/link xác thực mới;
    :Hệ thống gửi email chứa mã/link mới;
    :Hệ thống thông báo đã gửi lại email;
    break
  else (No)
    :Hệ thống thông báo lỗi (email không tồn tại hoặc đã được xác thực);
  endif
repeat while (Nhập lại email) is (Yes)
stop
@enduml

@startuml
title AD05 - Đăng nhập
|Actor|
start
:Người dùng chọn chức năng đăng nhập;
repeat
  |Actor|
  :Người dùng nhập email và mật khẩu;
  :Người dùng nhấn nút đăng nhập;
  |System|
  :Hệ thống kiểm tra thông tin đăng nhập;
  if (Thông tin chính xác?) then (Yes)
    if (Tài khoản đã xác thực?) then (Yes)
      if (Tài khoản có bị khóa không?) then (No)
        :Hệ thống tạo phiên đăng nhập;
        :Chuyển hướng người dùng đến trang chủ;
        break
      else (Yes)
        :Hệ thống thông báo tài khoản bị khóa;
        break
      endif
    else (No)
      :Hệ thống thông báo tài khoản chưa xác thực;
      :Gợi ý xác thực email;
      break
    endif
  else (No)
    :Hệ thống thông báo sai thông tin đăng nhập;
  endif
repeat while (Nhập lại) is (Yes)
stop
@enduml

@startuml
title AD06 - Đăng nhập qua Google
|Actor|
start
:Người dùng chọn đăng nhập bằng Google;
|System|
:Hệ thống chuyển hướng tới trang đăng nhập Google;
repeat
  |Actor|
  :Người dùng xác thực với Google;
  |System|
  if (Xác thực thành công?) then (Yes)
    :Google trả về thông tin người dùng;
    :Hệ thống kiểm tra email;
    if (Email đã tồn tại trong hệ thống?) then (Yes)
      :Hệ thống đăng nhập tài khoản hiện có;
    else (No)
      :Hệ thống tự động tạo tài khoản mới từ thông tin Google;
      :Hệ thống đăng nhập tài khoản mới;
    endif
    :Chuyển hướng người dùng đến trang chủ;
    break
  else (No)
    :Hệ thống thông báo đăng nhập thất bại;
  endif
repeat while (Thử lại) is (Yes)
stop
@enduml

@startuml
title AD07 - Đăng xuất
|Actor|
start
:Người dùng chọn chức năng đăng xuất;
|System|
:Hệ thống xác nhận yêu cầu đăng xuất;
:Hệ thống hủy phiên đăng nhập hiện tại;
:Chuyển hướng người dùng về trang chủ hoặc trang đăng nhập;
stop
@enduml

@startuml
title AD08 - Quên mật khẩu
|Actor|
start
:Người dùng chọn quên mật khẩu;
repeat
  |Actor|
  :Người dùng nhập địa chỉ email;
  |System|
  :Hệ thống kiểm tra email;
  if (Email tồn tại trong hệ thống?) then (Yes)
    :Hệ thống tạo mã khôi phục mật khẩu;
    :Hệ thống gửi email chứa link/mã khôi phục;
    :Hệ thống thông báo đã gửi hướng dẫn khôi phục;
    break
  else (No)
    :Hệ thống thông báo email không tồn tại;
  endif
repeat while (Nhập lại email) is (Yes)
stop
@enduml

@startuml
title AD09 - Đặt lại mật khẩu
|Actor|
start
:Người dùng truy cập link khôi phục hoặc nhập mã khôi phục;
|System|
:Hệ thống kiểm tra tính hợp lệ của link/mã;
if (Link/mã hợp lệ và chưa hết hạn?) then (Yes)
  :Hệ thống hiển thị form nhập mật khẩu mới;
  repeat
    |Actor|
    :Người dùng nhập mật khẩu mới và xác nhận mật khẩu;
    |System|
    :Hệ thống kiểm tra độ mạnh và tính trùng khớp của mật khẩu;
    if (Mật khẩu hợp lệ?) then (Yes)
      :Hệ thống cập nhật mật khẩu mới;
      :Hệ thống thông báo đặt lại mật khẩu thành công;
      :Chuyển hướng người dùng đến trang đăng nhập;
      break
    else (No)
      :Hệ thống thông báo lỗi mật khẩu;
      :Yêu cầu nhập lại mật khẩu mới;
    endif
  repeat while (Nhập lại) is (Yes)
else (No)
  :Hệ thống thông báo link/mã không hợp lệ hoặc đã hết hạn;
endif
stop
@enduml

@startuml
title AD10 - Xem danh sách sản phẩm
|Actor|
start
:Người dùng truy cập trang danh sách sản phẩm;
:Người dùng có thể chọn bộ lọc hoặc phân trang;
|System|
:Hệ thống lấy danh sách sản phẩm theo tiêu chí;
if (Có sản phẩm nào phù hợp?) then (Yes)
  :Hệ thống hiển thị danh sách sản phẩm;
else (No)
  :Hệ thống thông báo không có sản phẩm nào;
endif
stop
@enduml

@startuml
title AD11 - Tìm kiếm sản phẩm
|Actor|
start
repeat
  |Actor|
  :Người dùng nhập từ khóa tìm kiếm;
  :Người dùng nhấn tìm kiếm;
  |System|
  :Hệ thống lưu lại từ khóa vào lịch sử tìm kiếm;
  :Hệ thống tìm kiếm sản phẩm phù hợp với từ khóa;
  if (Tìm thấy sản phẩm?) then (Yes)
    :Hệ thống hiển thị danh sách sản phẩm kết quả;
    break
  else (No)
    :Hệ thống thông báo không tìm thấy sản phẩm phù hợp;
    :Hiển thị gợi ý tìm kiếm;
  endif
repeat while (Tìm kiếm lại) is (Yes)
stop
@enduml

@startuml
title AD12 - Xem lịch sử tìm kiếm
|Actor|
start
:Người dùng nhấp vào thanh tìm kiếm;
|System|
:Hệ thống truy xuất lịch sử tìm kiếm của người dùng;
if (Có lịch sử tìm kiếm?) then (Yes)
  :Hệ thống hiển thị danh sách các từ khóa tìm kiếm gần đây;
else (No)
  :Hệ thống không hiển thị lịch sử;
endif
stop
@enduml

@startuml
title AD13 - Gửi yêu cầu thêm sản phẩm
|Actor|
start
:Nhân viên chọn chức năng gửi yêu cầu thêm sản phẩm;
repeat
  |Actor|
  :Nhân viên điền thông tin sản phẩm mới (tên, giá, mô tả, hình ảnh);
  :Nhân viên gửi yêu cầu;
  |System|
  :Hệ thống kiểm tra thông tin nhập vào;
  if (Thông tin hợp lệ?) then (Yes)
    :Hệ thống tạo yêu cầu thêm sản phẩm ở trạng thái chờ duyệt;
    :Hệ thống thông báo gửi yêu cầu thành công;
    break
  else (No)
    :Hệ thống thông báo lỗi nhập liệu;
    :Yêu cầu nhân viên sửa lại thông tin;
  endif
repeat while (Sửa lại thông tin) is (Yes)
stop
@enduml

@startuml
title AD14 - Gửi yêu cầu cập nhật sản phẩm
|Actor|
start
:Nhân viên chọn sản phẩm cần cập nhật;
:Nhân viên chọn chức năng gửi yêu cầu cập nhật;
repeat
  |Actor|
  :Nhân viên chỉnh sửa thông tin sản phẩm;
  :Nhân viên gửi yêu cầu;
  |System|
  :Hệ thống kiểm tra thông tin nhập vào;
  if (Thông tin hợp lệ?) then (Yes)
    :Hệ thống tạo yêu cầu cập nhật sản phẩm ở trạng thái chờ duyệt;
    :Hệ thống thông báo gửi yêu cầu thành công;
    break
  else (No)
    :Hệ thống thông báo lỗi nhập liệu;
    :Yêu cầu nhân viên sửa lại thông tin;
  endif
repeat while (Sửa lại thông tin) is (Yes)
stop
@enduml

@startuml
title AD15 - Gửi yêu cầu xóa sản phẩm
|Actor|
start
:Nhân viên chọn sản phẩm cần xóa;
:Nhân viên chọn chức năng gửi yêu cầu xóa;
:Nhân viên nhập lý do xóa (tùy chọn);
:Nhân viên xác nhận gửi yêu cầu;
|System|
:Hệ thống tạo yêu cầu xóa sản phẩm ở trạng thái chờ duyệt;
:Hệ thống thông báo gửi yêu cầu thành công;
stop
@enduml

@startuml
title AD16 - Duyệt yêu cầu thay đổi sản phẩm
|Actor|
start
:Quản lý xem danh sách yêu cầu thay đổi;
:Quản lý chọn một yêu cầu đang chờ duyệt;
:Quản lý xem chi tiết yêu cầu;
:Quản lý chọn chức năng phê duyệt;
|System|
:Hệ thống cập nhật trạng thái yêu cầu thành đã duyệt;
:Hệ thống áp dụng thay đổi vào danh mục sản phẩm chính;
:Hệ thống thông báo phê duyệt thành công;
stop
@enduml

@startuml
title AD17 - Từ chối yêu cầu thay đổi sản phẩm
|Actor|
start
:Quản lý xem danh sách yêu cầu thay đổi;
:Quản lý chọn một yêu cầu đang chờ duyệt;
:Quản lý xem chi tiết yêu cầu;
:Quản lý chọn chức năng từ chối;
:Quản lý nhập lý do từ chối;
|System|
:Hệ thống cập nhật trạng thái yêu cầu thành bị từ chối;
:Hệ thống lưu lý do từ chối;
:Hệ thống thông báo từ chối thành công;
stop
@enduml

@startuml
title AD18 - Xem danh sách yêu cầu thay đổi
|Actor|
start
:Người dùng (Quản lý/Nhân viên) chọn xem danh sách yêu cầu;
:Người dùng có thể chọn bộ lọc (loại yêu cầu, trạng thái);
|System|
:Hệ thống lấy danh sách yêu cầu theo tiêu chí;
if (Có yêu cầu nào phù hợp?) then (Yes)
  :Hệ thống hiển thị danh sách yêu cầu;
else (No)
  :Hệ thống thông báo danh sách trống;
endif
stop
@enduml

@startuml
title AD19 - Thêm sản phẩm trực tiếp
|Actor|
start
:Quản lý chọn chức năng thêm sản phẩm mới;
repeat
  |Actor|
  :Quản lý nhập thông tin sản phẩm;
  :Quản lý nhấn lưu;
  |System|
  :Hệ thống kiểm tra thông tin;
  if (Thông tin hợp lệ?) then (Yes)
    :Hệ thống thêm sản phẩm vào danh mục;
    :Hệ thống thông báo thêm thành công;
    break
  else (No)
    :Hệ thống thông báo lỗi;
    :Yêu cầu kiểm tra lại thông tin;
  endif
repeat while (Nhập lại) is (Yes)
stop
@enduml

@startuml
title AD20 - Cập nhật sản phẩm trực tiếp
|Actor|
start
:Quản lý chọn sản phẩm cần cập nhật;
repeat
  |Actor|
  :Quản lý thay đổi thông tin sản phẩm;
  :Quản lý nhấn lưu;
  |System|
  :Hệ thống kiểm tra thông tin;
  if (Thông tin hợp lệ?) then (Yes)
    :Hệ thống cập nhật thông tin sản phẩm;
    :Hệ thống thông báo cập nhật thành công;
    break
  else (No)
    :Hệ thống thông báo lỗi;
    :Yêu cầu kiểm tra lại thông tin;
  endif
repeat while (Nhập lại) is (Yes)
stop
@enduml

@startuml
title AD21 - Xóa sản phẩm trực tiếp
|Actor|
start
:Quản lý chọn sản phẩm cần xóa;
:Quản lý chọn chức năng xóa;
|System|
:Hệ thống yêu cầu xác nhận xóa;
|Actor|
if (Quản lý xác nhận?) then (Yes)
  |System|
  :Hệ thống kiểm tra ràng buộc của sản phẩm (ví dụ: có đơn hàng không);
  if (Có ràng buộc?) then (Yes)
    :Hệ thống thông báo không thể xóa;
    :Chuyển trạng thái sản phẩm sang ngưng kinh doanh;
  else (No)
    :Hệ thống xóa sản phẩm khỏi danh mục;
    :Hệ thống thông báo xóa thành công;
  endif
else (No)
  |System|
  :Hủy thao tác xóa;
endif
stop
@enduml

@startuml
title AD22 - Xem giỏ hàng
|Actor|
start
:Người dùng chọn chức năng xem giỏ hàng;
|System|
:Hệ thống lấy thông tin giỏ hàng của người dùng;
if (Giỏ hàng có sản phẩm?) then (Yes)
  :Hệ thống hiển thị danh sách sản phẩm, số lượng, giá và tổng tiền;
else (No)
  :Hệ thống thông báo giỏ hàng trống;
  :Hiển thị nút tiếp tục mua sắm;
endif
stop
@enduml

@startuml
title AD23 - Thêm sản phẩm vào giỏ
|Actor|
start
:Người dùng xem chi tiết sản phẩm;
repeat
  |Actor|
  :Người dùng chọn số lượng và nhấn thêm vào giỏ;
  |System|
  :Hệ thống kiểm tra số lượng tồn kho;
  if (Đủ số lượng tồn kho?) then (Yes)
    if (Sản phẩm đã có trong giỏ?) then (Yes)
      :Hệ thống tăng số lượng sản phẩm trong giỏ;
    else (No)
      :Hệ thống thêm sản phẩm mới vào giỏ;
    endif
    :Hệ thống thông báo thêm thành công;
    break
  else (No)
    :Hệ thống thông báo không đủ hàng;
  endif
repeat while (Thử chọn số lượng khác) is (Yes)
stop
@enduml

@startuml
title AD24 - Cập nhật số lượng
|Actor|
start
:Người dùng đang ở trang giỏ hàng;
repeat
  |Actor|
  :Người dùng thay đổi số lượng của một sản phẩm;
  |System|
  :Hệ thống kiểm tra số lượng tồn kho;
  if (Số lượng hợp lệ và đủ tồn kho?) then (Yes)
    :Hệ thống cập nhật số lượng mới trong giỏ hàng;
    :Hệ thống tính toán lại tổng tiền;
    break
  else (No)
    :Hệ thống thông báo lỗi số lượng;
    :Khôi phục lại số lượng cũ;
  endif
repeat while (Nhập lại số lượng) is (Yes)
stop
@enduml

@startuml
title AD25 - Xóa sản phẩm khỏi giỏ
|Actor|
start
:Người dùng đang ở trang giỏ hàng;
:Người dùng chọn xóa một sản phẩm;
|System|
:Hệ thống loại bỏ sản phẩm khỏi giỏ hàng;
:Hệ thống tính toán lại tổng tiền;
:Hệ thống cập nhật hiển thị giỏ hàng;
stop
@enduml

@startuml
title AD26 - Xem danh sách yêu thích
|Actor|
start
:Người dùng chọn chức năng xem danh sách yêu thích;
|System|
:Hệ thống truy xuất danh sách sản phẩm yêu thích;
if (Danh sách có sản phẩm?) then (Yes)
  :Hệ thống hiển thị danh sách sản phẩm yêu thích;
else (No)
