title AD75 - Xem danh sách đơn hàng (Admin)
|Actor|
start
:Admin truy cập trang Quản lý đơn hàng;
|System|
:Hệ thống lấy toàn bộ danh sách đơn hàng trong hệ thống;
if (Có đơn hàng không?) then (Yes)
  :Hệ thống hiển thị danh sách đơn hàng kèm bộ lọc trạng thái;
  |Actor|
  if (Admin chọn một đơn hàng?) then (Yes)
    |System|
    :Hệ thống hiển thị chi tiết đơn hàng đã chọn;
  else (No)
  endif
else (No)
  :Hệ thống hiển thị danh sách trống;
endif
stop
@enduml

@startuml
title AD76 - Cập nhật trạng thái đơn hàng (Admin)
|Actor|
start
:Admin chọn đơn hàng cần cập nhật trạng thái;
repeat
  :Admin chọn trạng thái xử lý mới;
  |System|
  :Hệ thống kiểm tra tính hợp lệ của luồng trạng thái;
  if (Trạng thái chuyển đổi hợp lệ?) then (Yes)
    :Hệ thống cập nhật trạng thái mới cho đơn hàng;
    :Hệ thống ghi log lịch sử đơn hàng;
    :Hệ thống gửi thông báo cập nhật cho khách hàng;
    :Hệ thống thông báo cập nhật thành công;
    break
  else (No)
    :Hệ thống báo lỗi luồng trạng thái không hợp lệ;
    :Yêu cầu chọn lại trạng thái;
  endif
repeat while (Chọn lại trạng thái) is (Yes)
stop
@enduml

@startuml
title AD77 - Cập nhật trạng thái thanh toán
|Actor|
start
:Admin chọn đơn hàng cần cập nhật trạng thái thanh toán;
repeat
  :Admin chọn trạng thái thanh toán mới (Chưa thanh toán, Đã thanh toán, Hoàn tiền);
  |System|
  :Hệ thống kiểm tra thông tin hợp lệ;
  if (Thông tin hợp lệ?) then (Yes)
    :Hệ thống cập nhật trạng thái thanh toán của đơn hàng;
    :Hệ thống thông báo cập nhật thành công;
    break
  else (No)
    :Hệ thống thông báo lỗi;
    :Yêu cầu chọn lại;
  endif
repeat while (Chọn lại) is (Yes)
stop
@enduml

@startuml
title AD78 - Cập nhật thông tin vận chuyển
|Actor|
start
:Admin chọn đơn hàng cần cập nhật thông tin vận chuyển;
repeat
  :Admin nhập đơn vị vận chuyển và mã vận đơn (Tracking number);
  :Admin bấm lưu thông tin vận chuyển;
  |System|
  :Hệ thống kiểm tra tính hợp lệ của mã vận đơn;
  if (Mã vận đơn hợp lệ?) then (Yes)
    :Hệ thống lưu thông tin vận chuyển vào đơn hàng;
    :Hệ thống gửi thông tin theo dõi cho khách hàng;
    :Hệ thống thông báo cập nhật thành công;
    break
  else (No)
    :Hệ thống báo lỗi mã vận đơn không hợp lệ;
    :Yêu cầu kiểm tra và nhập lại;
  endif
repeat while (Nhập lại mã vận đơn) is (Yes)
stop
@enduml

@startuml
title AD79 - Xem đánh giá (Admin)
|Actor|
start
:Admin truy cập chức năng Quản lý đánh giá;
|System|
:Hệ thống lấy toàn bộ danh sách đánh giá từ hệ thống;
if (Có đánh giá nào không?) then (Yes)
  :Hệ thống hiển thị danh sách đánh giá kèm các bộ lọc;
  |Actor|
  if (Admin chọn xem chi tiết một đánh giá?) then (Yes)
    |System|
    :Hệ thống hiển thị chi tiết đánh giá, khách hàng và sản phẩm tương ứng;
  else (No)
  endif
else (No)
  :Hệ thống thông báo chưa có đánh giá nào;
endif
stop
@enduml

@startuml
title AD80 - Chỉnh sửa đánh giá (Admin)
|Actor|
start
:Admin chọn đánh giá cần chỉnh sửa hoặc kiểm duyệt;
|System|
:Hệ thống hiển thị thông tin đánh giá;
repeat
  |Actor|
  :Admin chỉnh sửa nội dung hoặc thay đổi trạng thái (Hiển thị/Ẩn);
  :Admin bấm lưu thay đổi;
  |System|
  :Hệ thống kiểm tra tính hợp lệ;
  if (Thông tin hợp lệ?) then (Yes)
    :Hệ thống cập nhật nội dung/trạng thái của đánh giá;
    :Hệ thống tính toán lại điểm trung bình nếu đánh giá bị ẩn;
    :Hệ thống thông báo cập nhật thành công;
    break
  else (No)
    :Hệ thống báo lỗi thông tin không hợp lệ;
    :Yêu cầu chỉnh sửa lại;
  endif
repeat while (Chỉnh sửa lại) is (Yes)
stop
@enduml

@startuml
title AD81 - Xóa đánh giá (Admin)
|Actor|
start
:Admin chọn đánh giá vi phạm cần xóa;
|System|
:Hệ thống yêu cầu xác nhận xóa vĩnh viễn;
|Actor|
if (Admin xác nhận xóa?) then (Yes)
  |System|
  :Hệ thống xóa đánh giá khỏi cơ sở dữ liệu;
  :Hệ thống cập nhật lại điểm đánh giá trung bình của sản phẩm;
  :Hệ thống thông báo xóa thành công;
else (No)
  |System|
  :Hủy thao tác xóa;
endif
stop
@enduml

@startuml
title AD82 - Xem danh sách mã giảm giá (Admin)
|Actor|
start
:Admin chọn chức năng Quản lý mã giảm giá;
|System|
:Hệ thống lấy danh sách tất cả mã giảm giá trong hệ thống;
if (Có mã giảm giá không?) then (Yes)
  :Hệ thống hiển thị danh sách mã giảm giá;
else (No)
  :Hệ thống thông báo danh sách trống;
endif
stop
@enduml

@startuml
title AD83 - Tạo mã giảm giá (Admin)
|Actor|
start
:Admin chọn "Thêm mã giảm giá mới";
|System|
:Hệ thống hiển thị biểu mẫu tạo mã giảm giá hệ thống;
repeat
  |Actor|
  :Admin nhập mã, tỉ lệ/mức giảm, giới hạn sử dụng, thời gian hiệu lực;
  :Admin bấm lưu;
  |System|
  :Hệ thống kiểm tra tính hợp lệ và trùng lặp mã;
  if (Mã hợp lệ và chưa tồn tại?) then (Yes)
    :Hệ thống lưu mã giảm giá mới;
    :Hệ thống thông báo tạo mã thành công;
    break
  else (No)
    :Hệ thống thông báo lỗi trùng mã hoặc thông tin không hợp lệ;
    :Yêu cầu nhập lại;
  endif
repeat while (Nhập lại thông tin) is (Yes)
stop
@enduml

@startuml
title AD84 - Cập nhật mã giảm giá (Admin)
|Actor|
start
:Admin chọn mã giảm giá cần cập nhật;
|System|
:Hệ thống hiển thị chi tiết mã giảm giá;
repeat
  |Actor|
  :Admin thay đổi thông tin (Hạn sử dụng, Mức giảm, Trạng thái kích hoạt);
  :Admin bấm cập nhật;
  |System|
  :Hệ thống kiểm tra tính hợp lệ;
  if (Thông tin hợp lệ?) then (Yes)
    :Hệ thống lưu thông tin thay đổi;
    :Hệ thống thông báo cập nhật thành công;
    break
  else (No)
    :Hệ thống thông báo lỗi;
    :Yêu cầu nhập lại;
  endif
repeat while (Nhập lại thông tin) is (Yes)
stop
@enduml

@startuml
title AD85 - Phát hành mã cho người dùng (Admin)
|Actor|
start
:Admin chọn mã giảm giá cần phát hành;
:Admin chọn chức năng Phát hành mã;
|System|
:Hệ thống hiển thị danh sách người dùng hoặc nhóm đối tượng;
repeat
  |Actor|
  :Admin chọn người dùng mục tiêu và xác nhận;
  |System|
  :Hệ thống kiểm tra người dùng hợp lệ;
  if (Người dùng hợp lệ?) then (Yes)
    :Hệ thống gán mã giảm giá vào ví voucher của người dùng;
    :Hệ thống gửi thông báo/email cho người dùng;
    :Hệ thống thông báo phát hành thành công;
    break
  else (No)
    :Hệ thống thông báo lỗi không tìm thấy người dùng;
    :Yêu cầu chọn lại đối tượng;
  endif
repeat while (Chọn lại đối tượng) is (Yes)
stop
@enduml

@startuml
title AD86 - Xem yêu cầu người bán (Admin)
|Actor|
start
:Admin truy cập Quản lý yêu cầu người bán;
|System|
:Hệ thống tải danh sách yêu cầu đăng ký người bán;
if (Có yêu cầu nào không?) then (Yes)
  :Hệ thống hiển thị danh sách các yêu cầu;
  |Actor|
  :Admin chọn xem chi tiết một yêu cầu;
  |System|
  :Hệ thống hiển thị đầy đủ thông tin đăng ký của khách hàng;
else (No)
  :Hệ thống thông báo danh sách trống;
endif
stop
@enduml

@startuml
title AD87 - Duyệt / Từ chối người bán (Admin)
|Actor|
start
:Admin xem chi tiết hồ sơ đăng ký người bán;
if (Hồ sơ đạt yêu cầu?) then (Yes)
  :Admin chọn "Phê duyệt";
  |System|
  :Hệ thống cập nhật trạng thái "Đã duyệt";
  :Hệ thống phân quyền "Người bán" cho tài khoản;
  :Hệ thống gửi thông báo chúc mừng tới người dùng;
else (No)
  |Actor|
  :Admin chọn "Từ chối";
  :Admin nhập lý do từ chối;
  |System|
  :Hệ thống cập nhật trạng thái "Bị từ chối";
  :Hệ thống gửi thông báo từ chối kèm lý do cho người dùng;
endif
stop
@enduml

@startuml
title AD88 - Xem yêu cầu thay đổi sản phẩm (Admin)
|Actor|
start
:Admin truy cập Quản lý yêu cầu thay đổi sản phẩm;
|System|
:Hệ thống lấy danh sách các yêu cầu (Thêm/Sửa/Xóa sản phẩm) đang chờ duyệt;
if (Có yêu cầu nào không?) then (Yes)
  :Hệ thống hiển thị danh sách yêu cầu;
  |Actor|
  :Admin chọn một yêu cầu để xem chi tiết;
  |System|
  :Hệ thống hiển thị nội dung thay đổi và thông tin sản phẩm liên quan;
else (No)
  :Hệ thống thông báo không có yêu cầu nào chờ duyệt;
endif
stop
@enduml

@startuml
title AD89 - Duyệt / Từ chối thay đổi sản phẩm (Admin)
|Actor|
start
:Admin xem xét chi tiết yêu cầu thay đổi sản phẩm;
if (Nội dung thay đổi hợp lệ?) then (Yes)
  :Admin chọn "Phê duyệt";
  |System|
  :Hệ thống áp dụng các thay đổi vào danh mục sản phẩm chính;
  :Hệ thống cập nhật trạng thái yêu cầu thành "Đã duyệt";
  :Hệ thống gửi thông báo phê duyệt cho người bán;
else (No)
  |Actor|
  :Admin chọn "Từ chối";
  :Admin nhập lý do từ chối;
  |System|
  :Hệ thống cập nhật trạng thái yêu cầu thành "Bị từ chối";
  :Hệ thống gửi thông báo từ chối kèm lý do cho người bán;
endif
stop
@enduml
