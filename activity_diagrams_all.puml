@startuml
title AD58 - Kiểm tra mã giảm giá
|Actor|
start
repeat
  :Khách hàng nhập hoặc chọn mã giảm giá trong giỏ hàng/thanh toán;
  :Bấm nút "Áp dụng";
|System|
  :Hệ thống kiểm tra mã giảm giá trong cơ sở dữ liệu;
  if (Mã tồn tại?) then (Yes)
    :Kiểm tra điều kiện áp dụng (số lượng còn, hạn sử dụng, giá trị đơn hàng tối thiểu...);
    if (Đủ điều kiện áp dụng?) then (Yes)
      :Hệ thống thông báo mã hợp lệ;
      :Tính toán số tiền được giảm;
      break
    else (No)
      :Hệ thống thông báo mã không đủ điều kiện (chưa đạt giá trị tối thiểu, hết lượt...);
    endif
  else (No)
    :Hệ thống báo lỗi mã giảm giá không tồn tại;
  endif
repeat while (Nhập mã khác?) is (Yes) not (No)
stop
@enduml

