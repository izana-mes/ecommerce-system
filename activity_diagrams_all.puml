  |System|
  :Hệ thống kiểm tra thông tin mới hợp lệ;
  if (Thông tin hợp lệ?) then (Yes)
    :Hệ thống lưu thông tin thay đổi;
    :Hệ thống thông báo cập nhật thành công;
    break
  else (No)
    :Hệ thống thông báo lỗi "Thông tin không hợp lệ";
    :Yêu cầu nhập lại thông tin hợp lệ;
  endif
repeat while (Nhập lại thông tin) is (Yes)
stop
