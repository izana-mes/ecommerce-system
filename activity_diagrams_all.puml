  |Actor|
  :Khách hàng thực hiện thanh toán trên VNPay;
  |System|
  if (Thanh toán thành công trên VNPay?) then (Yes)
    :VNPay chuyển hướng về trang kết quả với trạng thái thành công;
    :Hệ thống ghi nhận giao dịch thành công (tạm thời);
  else (No)
    :VNPay chuyển hướng về trang kết quả với trạng thái thất bại/hủy;
    :Hệ thống hiển thị lỗi thanh toán thất bại;
  endif
else (No)
  :Hệ thống thông báo lỗi kết nối cổng thanh toán;
endif
stop
@enduml

@startuml
title AD39 - Xử lý IPN VNPay
|Actor|
start
:Máy chủ VNPay gửi yêu cầu IPN;
|System|
:Hệ thống nhận yêu cầu IPN từ máy chủ VNPay;
:Hệ thống xác thực mã băm (Secure Hash) của IPN;
if (Mã băm hợp lệ?) then (Yes)
  :Kiểm tra mã đơn hàng (vnp_TxnRef);
  if (Đơn hàng tồn tại và trạng thái hợp lệ?) then (Yes)
    :Kiểm tra số tiền thanh toán;
    if (Số tiền khớp với đơn hàng?) then (Yes)
      if (Mã phản hồi vnp_ResponseCode là 00 (Thành công)?) then (Yes)
        :Cập nhật trạng thái thanh toán đơn hàng thành "Đã thanh toán";
      else (No)
        :Cập nhật trạng thái thanh toán đơn hàng thành "Thất bại";
      endif
      :Trả mã phản hồi RspCode="00" cho VNPay;
    else (No)
      :Ghi log lỗi số tiền không khớp;
      :Trả mã phản hồi RspCode="04" cho VNPay;
    endif
  else (No)
    :Ghi log lỗi đơn hàng không hợp lệ;
    :Trả mã phản hồi RspCode="01" hoặc "02" cho VNPay;
  endif
else (No)
  :Ghi log lỗi xác thực sai (Invalid Checksum);
  :Trả mã phản hồi RspCode="97" cho VNPay;
endif
stop
@enduml

@startuml
