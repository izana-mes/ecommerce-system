if (Có mã giảm giá không?) then (Yes)
  :Hệ thống hiển thị danh sách mã giảm giá;
else (No)
  :Hệ thống thông báo danh sách trống;
endif
stop
@enduml

@startuml
title AD62 - Tạo mã giảm giá (Module Mã giảm giá)
|Actor|
start
:Người bán chọn "Tạo mã giảm giá";
|System|
:Hệ thống hiển thị biểu mẫu tạo mã giảm giá;
repeat
  |Actor|
  :Người bán nhập thông tin (Mã, Loại, Giá trị, Điều kiện, Hạn sử dụng);
  :Người bán chọn "Lưu";
  |System|
  :Hệ thống kiểm tra thông tin hợp lệ;
  if (Thông tin hợp lệ?) then (Yes)
    :Hệ thống kiểm tra mã giảm giá trùng lặp;
    if (Mã đã tồn tại?) then (Yes)
      :Hệ thống thông báo lỗi "Mã đã tồn tại";
      :Yêu cầu nhập lại mã;
    else (No)
      :Hệ thống lưu mã giảm giá mới;
      :Hệ thống thông báo tạo thành công;
      break
    endif
  else (No)
    :Hệ thống thông báo lỗi "Thông tin không hợp lệ";
    :Yêu cầu chỉnh sửa lại;
  endif
repeat while (Nhập lại thông tin) is (Yes)
stop
@enduml

