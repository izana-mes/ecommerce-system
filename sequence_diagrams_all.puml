```plantuml
@startuml
title SD01 - Quản lý tài khoản cá nhân
actor "Khách hàng" as Actor
participant "Frontend" as FE
participant "AuthMeController" as Ctrl
participant "AuthServiceImpl" as Service
participant "UserRepository" as Repo
database "DB" as DB

Actor -> FE: Truy cập trang cá nhân
FE -> Ctrl: GET /api/v1/auth/me
Ctrl -> Service: getCurrentUser()
Service -> Repo: findById()
Repo -> DB: query
DB --> Repo: user data
Repo --> Service: user info
Service --> Ctrl: user info
Ctrl --> FE: user info
FE --> Actor: Hiển thị thông tin
Actor -> FE: Chỉnh sửa và lưu
FE -> Ctrl: PUT /api/v1/auth/me
Ctrl -> Service: updateProfile()
Service -> Repo: validate()
alt Thông tin không hợp lệ
    Repo --> Service: error
    Service --> Ctrl: 400 Bad Request
    Ctrl --> FE: error message
    FE --> Actor: Hiển thị lỗi
else Thông tin hợp lệ
    alt Không có thay đổi
        Service --> Ctrl: no change
        Ctrl --> FE: 200 OK
        FE --> Actor: Giữ nguyên
    else Có thay đổi
        Service -> Repo: save()
        Repo -> DB: update
        DB --> Repo: success
        Repo --> Service: success
        Service --> Ctrl: 200 OK
        Ctrl --> FE: success
        FE --> Actor: Cập nhật thành công
    end
end
@enduml
```

```plantuml
@startuml
title SD02 - Đăng ký tài khoản
actor "Khách hàng" as Actor
participant "Frontend" as FE
participant "AuthController" as Ctrl
participant "AuthServiceImpl" as Service
participant "UserRepository" as Repo
participant "EmailMessagePublisher" as Email
database "DB" as DB

Actor -> FE: Điền form đăng ký
FE -> Ctrl: POST /api/v1/auth/register
Ctrl -> Service: register()
Service -> Repo: existsByEmailIgnoreCase()
Repo -> DB: query
DB --> Repo: result
alt Email đã tồn tại
    Repo --> Service: true
    Service --> Ctrl: 409 Conflict
    Ctrl --> FE: error message
    FE --> Actor: Báo lỗi email tồn tại
else Thông tin không hợp lệ hoặc sai mật khẩu
    Service --> Ctrl: 400 Bad Request
    Ctrl --> FE: error message
    FE --> Actor: Báo lỗi nhập liệu
else Hợp lệ
    Repo --> Service: false
    Service -> Repo: save()
    Repo -> DB: insert
    DB --> Repo: success
    Service -> Email: publish verification email
    Service --> Ctrl: 201 Created
    Ctrl --> FE: success message
    FE --> Actor: Thông báo kiểm tra email
end
@enduml
```

```plantuml
@startuml
title SD03 - Xác thực email
actor "Khách hàng" as Actor
participant "Frontend" as FE
participant "AuthController" as Ctrl
participant "AuthServiceImpl" as Service
participant "EmailVerificationTokenRepository" as Repo
participant "UserRepository" as UserRepo
database "DB" as DB

Actor -> FE: Click link xác thực
FE -> Ctrl: GET /api/v1/auth/verify-email?token=...
Ctrl -> Service: verifyEmail(token)
Service -> Repo: findByTokenHash()
Repo -> DB: query
DB --> Repo: token data
alt Token không hợp lệ / hết hạn
    Repo --> Service: null / expired
    Service --> Ctrl: 400 Bad Request
    Ctrl --> FE: error message
    FE --> Actor: Thông báo lỗi
else Hợp lệ
    Repo --> Service: token info
    Service -> UserRepo: save(isVerified=true)
    UserRepo -> DB: update
    DB --> UserRepo: success
    Service --> Ctrl: 200 OK
    Ctrl --> FE: success message
    FE --> Actor: Thông báo xác thực thành công
end
@enduml
```

```plantuml
@startuml
title SD04 - Gửi lại email xác thực
actor "Khách hàng" as Actor
participant "Frontend" as FE
participant "AuthController" as Ctrl
participant "AuthServiceImpl" as Service
participant "UserRepository" as UserRepo
participant "EmailVerificationTokenRepository" as Repo
participant "EmailMessagePublisher" as Email
database "DB" as DB

Actor -> FE: Yêu cầu gửi lại email
FE -> Ctrl: POST /api/v1/auth/resend-verification
Ctrl -> Service: resendVerificationEmail()
Service -> UserRepo: findByEmail()
UserRepo -> DB: query
DB --> UserRepo: user data
alt Tài khoản đã xác thực
    Service --> Ctrl: 400 Bad Request (Already verified)
    Ctrl --> FE: message
    FE --> Actor: Thông báo đã xác thực
else Chưa xác thực
    Service -> Repo: create/update token
    Repo -> DB: save
    DB --> Repo: success
    Service -> Email: publish verification email
    Service --> Ctrl: 200 OK
    Ctrl --> FE: success message
    FE --> Actor: Thông báo đã gửi email
end
@enduml
```

```plantuml
@startuml
title SD05 - Đăng nhập
actor "Khách hàng" as Actor
participant "Frontend" as FE
participant "AuthController" as Ctrl
participant "AuthServiceImpl" as Service
participant "AuthenticationManager" as AuthMgr
participant "TokenService" as TokenSvc
participant "AuthCookieService" as CookieSvc
participant "JwtProvider" as Jwt

Actor -> FE: Nhập email, password
FE -> Ctrl: POST /api/v1/auth/authenticate
Ctrl -> Service: authenticate()
Service -> AuthMgr: authenticate(credentials)
alt Sai thông tin (401)
    AuthMgr --> Service: AuthException
    Service --> Ctrl: 401 Unauthorized
    Ctrl --> FE: error message
    FE --> Actor: Thông báo sai thông tin
else Chưa xác thực email
    AuthMgr --> Service: UnverifiedException
    Service --> Ctrl: 403 Forbidden
    Ctrl --> FE: error message
    FE --> Actor: Yêu cầu xác thực email
else Thành công
    AuthMgr --> Service: UserDetails
    Service -> TokenSvc: createRefreshToken()
    Service -> Jwt: generateAccessToken()
    Service -> CookieSvc: writeAuthCookies()
    Service --> Ctrl: success
    Ctrl --> FE: 200 OK + Cookies
    FE --> Actor: Đăng nhập thành công
end
@enduml
```

```plantuml
@startuml
title SD06 - Đăng nhập qua Google
actor "Khách hàng" as Actor
participant "Frontend" as FE
participant "Spring Security" as Sec
participant "Google" as Google
participant "OAuth2AuthenticationSuccessHandler" as Handler
participant "AuthServiceImpl" as Service
participant "UserRepository" as Repo
participant "JwtProvider" as Jwt

Actor -> FE: Chọn Đăng nhập Google
FE -> Sec: GET /oauth2/authorize/google
Sec -> Google: Redirect to Google
Google --> Actor: Hiển thị màn hình đăng nhập Google
Actor -> Google: Xác nhận
Google -> Sec: callback
alt Từ chối / Lỗi
    Sec --> FE: Redirect with error
    FE --> Actor: Thông báo lỗi
else Thành công
    Sec -> Handler: onAuthenticationSuccess()
    Handler -> Service: processOAuth2User()
    Service -> Repo: find/create user
    Repo --> Service: user data
    Service -> Jwt: generate token
    Service --> Handler: JWT
    Handler --> FE: Redirect with JWT
    FE --> Actor: Đăng nhập thành công
end
@enduml
```

