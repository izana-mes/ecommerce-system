```plantuml
@startuml
title SD89 - Duyệt / Từ chối thay đổi sản phẩm (Admin - Module Quản trị)
actor "Quản trị viên" as Admin
participant "Frontend" as FE
participant "ProductController" as PC
participant "ProductChangeRequestService" as PCRS
participant "ProductChangeRequestRepository" as PCRR
participant "ProductService" as PS
participant "ProductRepository" as PR

Admin -> FE: Chọn yêu cầu, xem payload
alt chọn phê duyệt
    FE -> PC: POST /api/products/change-requests/{id}/approve {note}
    PC -> PCRS: approve(id, note)
    PCRS -> PCRR: findById(id)
    alt yêu cầu hợp lệ (PENDING)
        PCRR --> PCRS: Request entity
        PCRS -> PCRS: deserialize payload
        alt CREATE
            PCRS -> PS: createProduct(payload)
            PS -> PR: save()
        else UPDATE
            PCRS -> PS: updateProduct(targetId, payload)
            PS -> PR: save()
        else DELETE
            PCRS -> PS: deleteProduct(targetId)
            PS -> PR: delete()
        end
        alt cập nhật sản phẩm thành công
            PCRS -> PCRR: save(status=APPROVED)
            PCRS --> PC: Success
            PC --> FE: 200 OK
            FE --> Admin: Thông báo duyệt thành công
        else lỗi cập nhật sản phẩm
            PS --> PCRS: Lỗi logic/DB
            PCRS --> PC: Lỗi
            PC --> FE: 500 Internal Server Error
            FE --> Admin: Thông báo lỗi khi áp dụng
        end
    else không hợp lệ / đã xử lý
        PCRS --> PC: Lỗi
        PC --> FE: 400 Bad Request
        FE --> Admin: Thông báo lỗi
    end
else chọn từ chối
    FE -> PC: POST /api/products/change-requests/{id}/reject {note}
    PC -> PCRS: reject(id, note)
    PCRS -> PCRR: findById(id)
    alt yêu cầu hợp lệ
        PCRR --> PCRS: Request entity
        PCRS -> PCRR: save(status=REJECTED)
        PCRS --> PC: Success
        PC --> FE: 200 OK
        FE --> Admin: Thông báo từ chối thành công
    else không hợp lệ / đã xử lý
        PCRS --> PC: Lỗi
        PC --> FE: 400 Bad Request
        FE --> Admin: Thông báo lỗi
    end
end
@enduml
```
