# ==========================================================
# ECOMMERCE SYSTEM - CONFIG TO FILL
# Fill values, then copy into the right platform:
# - frontend/.env.local (local frontend)
# - Vercel Project Environment Variables (frontend deploy)
# - Render Backend Environment Variables (backend deploy)
# - docker-compose.yml env sections (Docker local stack)
# ==========================================================

# -------------------------
# Frontend -> Backend API
# -------------------------
BACKEND_API_BASE_URL=
NEXT_PUBLIC_API_URL=
BACKEND_URL=
NEXT_PUBLIC_BACKEND_URL=

# -------------------------
# OAuth (Google) - Backend
# -------------------------
SPRING_PROFILES_INCLUDE=oauth
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
APPLICATION_SERVER_URL=

# -------------------------
# Core Auth / Security
# -------------------------
JWT_SECRET_KEY=
AUTH_COOKIE_NAME=access_token

# -------------------------
# VNPay (Frontend + Backend)
# Must match between services where required.
# -------------------------
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
VNPAY_USD_TO_VND_RATE=26000
VNPAY_MIN_AMOUNT_VND=5000

# -------------------------
# Internal Notification Security
# -------------------------
INTERNAL_NOTIFY_TOKEN=

# -------------------------
# Backend Database (if not using DATABASE_URL)
# -------------------------
DB_HOST=
DB_PORT=5432
DB_NAME=shop
DB_USER=
DB_PASSWORD=

# Render style DB URL (recommended on Render)
DATABASE_URL=
POSTGRES_URL=
RENDER_DATABASE_URL=

# -------------------------
# Frontend local DB adapter (only if frontend routes use DB)
# -------------------------
DB_CLIENT=postgres

# -------------------------
# Redis
# -------------------------
SPRING_DATA_REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_TIMEOUT=10s

# -------------------------
# RabbitMQ
# -------------------------
SPRING_RABBITMQ_ENABLED=false
SPRING_RABBITMQ_URI=
SPRING_RABBITMQ_ADDRESSES=
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# -------------------------
# Email SMTP
# -------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# -------------------------
# Render / Hosting
# -------------------------
PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework
RENDER=
RENDER_EXTERNAL_URL=
RENDER_SERVICE_ID=

# -------------------------
# Optional feature tuning
# -------------------------
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FIRST_NAME=Admin
ADMIN_BOOTSTRAP_LAST_NAME=User

LOW_STOCK_THRESHOLD=5
SEARCH_HISTORY_MAX_ENTRIES=10
SEARCH_HISTORY_TTL_DAYS=30
REVIEWS_MAX_ENTRIES=10
REVIEWS_TTL_DAYS=30

CACHE_TTL_PRODUCTS_ALL_SECONDS=120
CACHE_TTL_PRODUCTS_SEARCH_SECONDS=60
CACHE_TTL_PRODUCTS_SUGGEST_SECONDS=45
CACHE_TTL_PRODUCTS_INVENTORY_HEALTH_SECONDS=30
CACHE_TTL_ADMIN_DASHBOARD_SECONDS=60

# -------------------------
# Messaging topology (optional override)
# -------------------------
MESSAGING_EXCHANGE=ecommerce.exchange
MESSAGING_QUEUE_ORDER_CREATED=order.created.queue
MESSAGING_QUEUE_ORDER_CREATED_DLQ=order.created.dlq
MESSAGING_QUEUE_ORDER_STATUS_CHANGED=order.status.changed.queue
MESSAGING_QUEUE_ORDER_STATUS_CHANGED_DLQ=order.status.changed.dlq
MESSAGING_QUEUE_ORDER_PAID_EMAIL=order.paid.email.queue
MESSAGING_QUEUE_ORDER_PAID_EMAIL_DLQ=order.paid.email.dlq
MESSAGING_QUEUE_LOW_STOCK_ALERT=inventory.low-stock.alert.queue
MESSAGING_QUEUE_LOW_STOCK_ALERT_DLQ=inventory.low-stock.alert.dlq
MESSAGING_QUEUE_REVIEW_SUBMITTED=review.submitted.queue
MESSAGING_QUEUE_REVIEW_SUBMITTED_DLQ=review.submitted.dlq
MESSAGING_QUEUE_AUDIT_EVENT=audit.event.queue
MESSAGING_QUEUE_AUDIT_EVENT_DLQ=audit.event.dlq
MESSAGING_QUEUE_PAYMENT_IPN=payment.ipn.queue
MESSAGING_QUEUE_PAYMENT_IPN_DLQ=payment.ipn.dlq
MESSAGING_QUEUE_EMAIL_GENERAL=email.general.queue
MESSAGING_QUEUE_EMAIL_GENERAL_DLQ=email.general.dlq

MESSAGING_ROUTING_KEY_ORDER_CREATED=order.created
MESSAGING_ROUTING_KEY_ORDER_STATUS_CHANGED=order.status.changed
MESSAGING_ROUTING_KEY_ORDER_PAID_EMAIL=order.paid.email
MESSAGING_ROUTING_KEY_LOW_STOCK_ALERT=inventory.low-stock.alert
MESSAGING_ROUTING_KEY_REVIEW_SUBMITTED=review.submitted
MESSAGING_ROUTING_KEY_AUDIT_EVENT=audit.event
MESSAGING_ROUTING_KEY_PAYMENT_IPN=payment.ipn
MESSAGING_ROUTING_KEY_EMAIL_GENERAL=email.general
