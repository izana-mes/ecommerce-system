<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty
            scope="context"
            name="APP_NAME"
            source="spring.application.name"
            defaultValue="shop-backend"/>

    <appender name="STDOUT"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">

            <providers>

                <timestamp/>

                <pattern>
                    <pattern>
                        {
                          "level": "%level",
                          "logger": "%logger{36}",
                          "thread": "%thread",
                          "message": "%msg",
                          "service": "${APP_NAME}",
                          "traceId": "%X{traceId:-}",
                          "spanId": "%X{spanId:-}",
                          "requestId": "%X{requestId:-}"
                        }
                    </pattern>
                </pattern>

                <mdc/>
                <stackTrace/>

            </providers>

        </encoder>

    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>