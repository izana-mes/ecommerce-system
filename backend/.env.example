# Copy this file to .env, fill in values, then load into your run config
# (Spring Boot does not read .env automatically — paste these as "Env File"
# in your IDE, or export them before `mvn spring-boot:run`).

# --- Database (local Postgres; or use DATABASE_URL instead) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shop
DB_USER=postgres
DB_PASSWORD=
# DATABASE_URL=postgresql://user:pass@host:5432/shop

# --- Public URLs ---
APPLICATION_SERVER_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
# Production (Render): set APPLICATION_SERVER_URL to https://your-api... so OAuth cookies use SameSite=None.
# If Vercel preview URL != FRONTEND_URL, list every origin (no trailing slash):
# CORS_ALLOWED_ORIGINS=https://app.vercel.app,https://frontend-xxx-team.vercel.app

# --- Vercel (set in Vercel project → Settings → Environment Variables, not in this file) ---
# NEXT_PUBLIC_API_URL=https://YOUR-RENDER-BACKEND.onrender.com/api
# BACKEND_URL=https://YOUR-RENDER-BACKEND.onrender.com
# Frontend fetch() to the API must use credentials: 'include' if you rely on the HttpOnly cookie after Google login.

# --- JWT (generate a long random string for production) ---
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET

# --- Mail provider ---
# MAIL_PROVIDER=smtp
# MAIL_PROVIDER=resend

# --- SMTP (Gmail: use an App Password, not your normal password) ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_CONNECTION_TIMEOUT=10000
SPRING_MAIL_TIMEOUT=10000
SPRING_MAIL_WRITE_TIMEOUT=10000

# --- Resend (recommended for production) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Shop

# --- Google Sign-In (OAuth2). Uncomment the line below only after both Google vars are set. ---
# SPRING_PROFILES_INCLUDE=oauth
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=

# --- Optional: Redis (defaults to redis://localhost:6379 if unset) ---
# SPRING_DATA_REDIS_URL=redis://localhost:6379
# REDIS_TIMEOUT=10s

# --- Optional: RabbitMQ (defaults to disabled; turn on when broker is running) ---
# SPRING_RABBITMQ_ENABLED=true
# SPRING_RABBITMQ_URI=amqp://guest:guest@localhost:5672

# --- Optional: VNPay ---
# VNPAY_HASH_SECRET=

# ──────────────────────────────────────────────────────────────────
# PayPal Checkout (Sandbox)
# Get credentials from: https://developer.paypal.com/dashboard/
# Applications > REST API apps > Create App
# ──────────────────────────────────────────────────────────────────
# PAYPAL_CLIENT_ID=AX...your-sandbox-client-id...XX
# PAYPAL_CLIENT_SECRET=EL...your-sandbox-client-secret...XX
# PAYPAL_MODE=sandbox    # Change to "live" for production

# --- Optional: internal notification API ---
# INTERNAL_NOTIFY_TOKEN=

# --- Optional: first admin user (defaults in application.yml) ---
# ADMIN_BOOTSTRAP_ENABLED=true
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=admin123

# --- Render only (enables Render-specific defaults) ---
# RENDER=true

# --- Server port ---
# PORT=8080
